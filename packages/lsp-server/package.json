{
	"name": "beancount-lsp-server",
	"version": "0.0.5",
	"description": "Language server for Beancount files with customizable tree-sitter WASM file path",
	"main": "dist/node/server.js",
	"browser": "dist/browser/server.js",
	"bin": {
		"beancount-lsp-server": "./dist/node/server.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "cross-env LSP_CLIENT_TYPE=vscode tsup && node scripts/prepare-client-assets.js",
		"build:npm": "tsup",
		"watch": "tsup --watch --onSuccess \"node scripts/prepare-client-assets.js\"",
		"typecheck": "tsc --noEmit true",
		"test": "vitest run",
		"test:wasm": "cross-env BEANCOUNT_WASM_PARSE_INTEGRATION=1 vitest run src/test/browser/incremental-parse-cache.wasm.test.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepublishOnly": "npm run build:npm"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"publishConfig": {
		"access": "public",
		"dependencies": {}
	},
	"devDependencies": {
		"@bean-lsp/shared": "workspace:*",
		"@bean-lsp/storage": "workspace:*",
		"@swc/core": "^1.15.46",
		"@types/big.js": "^7.0.0",
		"@types/micromatch": "^4.0.10",
		"big.js": "^7.0.1",
		"date-fns": "^4.4.0",
		"esbuild-plugins-node-modules-polyfill": "^1.8.2",
		"execa": "^10.0.0",
		"fast-glob": "^3.3.3",
		"micromatch": "^4.0.8",
		"mnemonist": "^0.40.4",
		"pinyin-pro": "^3.28.1",
		"pyodide": "0.29.3",
		"ts-pattern": "^5.9.0",
		"type-fest": "^5.8.0",
		"vitest": "^4.1.10",
		"vscode-languageserver": "^10.1.0",
		"vscode-languageserver-textdocument": "^1.0.12",
		"vscode-uri": "^3.1.0",
		"web-tree-sitter": "^0.20.8"
	},
	"dependencies": {
		"@remusao/smaz": "^2.2.0",
		"async-call-rpc": "^6.4.2",
		"beancount-wasm": "^0.3.2",
		"scheduler-polyfill": "^1.3.0",
		"untildify": "^6.0.0"
	}
}
